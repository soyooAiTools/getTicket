generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LOAD_CONTROL_DATABASE_URL")
}

enum ValidationMode {
  PREPROD
  OBSERVE_ONLY
  WHITELIST_FULL_PATH
  GRAY_VALIDATION
}

enum NodeRole {
  ANCHOR
  EDGE
  CONTROL
}

enum RunStatus {
  DRAFT
  PLANNED
  RUNNING
  STOPPING
  STOPPED
  COMPLETED
  FAILED
}

enum NodeHealthStatus {
  ONLINE
  DEGRADED
  OFFLINE
  BUSY
}

model NodePool {
  id             String             @id
  name           String
  region         String
  role           NodeRole
  status         NodeHealthStatus
  maxConcurrency Int
  nodeCount      Int                @default(0)
  activeNodeCount Int               @default(0)
  labels         Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  nodes          LoadControlNode[]
  runs           LoadControlRun[]
  assignments    LoadControlAssignment[]
}

model ScenarioTemplate {
  id          String          @id
  name        String
  description String
  definition  Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  runs        LoadControlRun[]
}

model LoadControlNode {
  id             String             @id
  poolId         String
  region         String
  role           NodeRole
  healthStatus   NodeHealthStatus
  maxConcurrency Int
  networkProfile Json?
  labels         Json
  lastSeenAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  pool           NodePool           @relation(fields: [poolId], references: [id], onDelete: Cascade)
  assignments    LoadControlAssignment[]
  summaries      LoadControlSummary[]
  telemetrySamples LoadControlTelemetrySample[]

  @@index([poolId, healthStatus])
  @@index([region, role])
}

model LoadControlRun {
  id             String           @id
  templateId     String
  nodePoolId     String
  mode           ValidationMode
  targetBaseUrl  String
  status         RunStatus        @default(DRAFT)
  tags           Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  template       ScenarioTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  nodePool       NodePool         @relation(fields: [nodePoolId], references: [id], onDelete: Cascade)
  assignments    LoadControlAssignment[]
  summaries      LoadControlSummary[]
  telemetrySamples LoadControlTelemetrySample[]

  @@index([templateId, status])
  @@index([nodePoolId, status])
}

model LoadControlAssignment {
  id         String          @id @default(cuid())
  runId      String
  nodeId     String
  poolId     String
  phasePlan  Json
  assignedAt DateTime        @default(now())
  run        LoadControlRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  node       LoadControlNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  pool       NodePool        @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId, assignedAt])
  @@index([poolId, assignedAt])
}

model LoadControlSummary {
  id         String          @id @default(cuid())
  runId      String
  nodeId     String
  payload    Json
  reportedAt DateTime        @default(now())
  run        LoadControlRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  node       LoadControlNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeId])
  @@index([runId, reportedAt])
}

model LoadControlTelemetrySample {
  id            String          @id @default(cuid())
  runId         String
  nodeId        String
  phaseId       String
  status        NodeHealthStatus
  qps           Float
  errorRate     Float
  p95LatencyMs  Int
  activeWorkers  Int
  recordedAt    DateTime
  run           LoadControlRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  node          LoadControlNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([runId, recordedAt])
  @@index([nodeId, recordedAt])
  @@index([phaseId, recordedAt])
}
